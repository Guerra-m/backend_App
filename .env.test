# .env.test — Variables para la suite de tests
# pytest carga este archivo via conftest.py

# BD SQLite en memoria (no toca PostgreSQL real)
TEST_DATABASE_URL=sqlite://

# JWT
SECRET_KEY=test-secret-key-fija-para-tests-no-usar-en-produccion-min-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging silencioso en tests
LOG_LEVEL=WARNING

# Rate limit alto para no interferir con tests funcionales
# Los tests de rate limit resetean el estado manualmente
RATE_LIMIT_DEFAULT_PER_MINUTE=10000
RATE_LIMIT_DEFAULT_BURST=1000
RATE_LIMIT_AUTH_PER_MINUTE=10000
RATE_LIMIT_AUTH_BURST=1000

# PostgreSQL (no se usa en tests pero evita errores de config)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MercadoPago (mock en tests)
MP_ACCESS_TOKEN=TEST-fake-token
MP_PUBLIC_KEY=TEST-fake-key
MP_WEBHOOK_SECRET=
MP_NGROK_URL=http://localhost:8000

# Cloudinary (mock en tests)
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=test-secret